#! /usr/bin/env python
# encoding: utf-8

# =============================================================================
# Файл: wscript (game/client)
# Назначение: Скрипт сборки клиентской DLL для всех модов Source Engine
#
# Этот wscript-скрипт (waf build system) определяет:
#   - Какие VPC-файлы использовать для каждого мода
#   - Include-пути для компилятора
#   - Библиотеки для линковки (tier0, vgui, LuaJIT и т.д.)
#   - Особые настройки для Garry's Mod (luajit, lua_vm)
#
# Моды: hl2, hl2mp, hl1, episodic, portal, cstrike, dod, garrysmod
#
# ВАЖНО: Для garrysmod добавляется библиотека luajit и lua_vm source files.
# =============================================================================

from waflib import Utils
import os
import vpc_parser

top = '.'
PROJECT_NAME = 'client'

def options(opt):
	return

# Словарь модов: ключ = имя мода, значение = список VPC-файлов
# Каждый мод имеет base VPC + свой собственный VPC
games = {
	'hl2': ['client_base.vpc', 'client_hl2.vpc'],
	'hl2mp': ['client_base.vpc', 'client_hl2mp.vpc'],
	'hl1': ['client_base.vpc', 'client_hl1.vpc'],
	'episodic': ['client_base.vpc', 'client_episodic.vpc'],
	'portal': ['client_base.vpc', 'client_portal.vpc'],
	'hl1mp': ['client_base.vpc', 'client_hl1mp.vpc'],
	'cstrike': ['client_base.vpc', 'client_cstrike.vpc'],
	'dod': ['client_base.vpc', 'client_dod.vpc'],
	'garrysmod': ['client_base.vpc', 'client_garrysmod.vpc'] # Garry's Mod
}

# configure() вызывается при ./waf configure. Запоминает имя мода.
def configure(conf):
	game = conf.options.GAMES
	conf.env.GAMES = game

	# Отключаем Steam API для некоммерческих сборок
	conf.env.append_unique('DEFINES', ['DISABLE_STEAM=1'])

	if game not in games.keys():
		conf.fatal("Couldn't find game: ", game)

# build() вызывается при ./waf build. Парсит VPC-файлы и собирает DLL.
def build(bld):
	# vpc_parser.parse_vpcs() читает VPC-файлы и извлекает source files,
	# include paths, и defines из конфигурации Visual Studio
	game = vpc_parser.parse_vpcs( bld.env, games[bld.env.GAMES], '../..' )

	# Include-пути: где искать заголовочные файлы (.h)
	includes = [
		'.',                     # текущая папка (game/client/)
		'game_controls',         # game controls (VGUI)
		'../../common',          # общие заголовки движка
		'../../public',          # публичные интерфейсы движка
		'../../public/tier0',    # tier0 (базовые утилиты)
		'../../public/tier1',    # tier1 (строки, консолидация)
		'../../vgui2/include',   # VGUI2 (GUI-система)
		'../../vgui2/controls',  # VGUI2 controls
		'../shared'              # общие файлы клиента и сервера
	]

	# Библиотеки для линковки (все .lib/.a файлы которые нужны клиенту)
	libs = [
		'tier0',        # базовые утилиты (CUtlVector, ConVar и т.д.)
		'particles',    # система частиц
		'dmxloader',    # загрузчик DMX-файлов
		'vgui_controls', # VGUI контроллы (кнопки, панели)
		'matsys_controls', # Material System controls
		'tier1',        # строки, keyvalues
		'tier2',        # VGUI интерфейсы
		'tier3',        # VGUI интерфейсы ( расширенные)
		'mathlib',      # математические функции (Vector, Angle, matrix)
		'vstdlib',      # вспомогательные функции движка
		'choreoobjects', # choreography objects (для анимаций)
		'steam_api',    # Steam API (achievements, friends)
		'bitmap',       # работа с изображениями
		'vtf',          # VTF texture format (формат текстур Valve)
		'RT',           # Render Target
		'ZLIB'          # сжатие данных
	]

	# Для Garry's Mod добавляем LuaJIT — виртуальную машину Lua
	# LuaJIT нужен для выполнения Lua-скриптов GMod (hook.lua, gamemode)
	if bld.env.GAMES == 'garrysmod':
		libs += ['LUAJIT']

	install_path = bld.env.PREFIX
	if bld.env.DEST_OS != 'android':
		install_path += '/'+bld.env.GAMES+'/bin'

	source = [ 'in_touch.cpp' ]
	if bld.env.DEST_OS == 'win32':
		libs += ['USER32']

	source += game["sources"] + ['../../public/tier0/memoverride.cpp']
	includes += game["includes"]
	defines = game["defines"]

	defines.remove('PROTECTED_THINGS_ENABLE')

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		install_path = install_path,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)

